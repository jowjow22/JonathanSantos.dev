# Dev.to integration
VITE_DEV_API_KEY=your_devto_api_key_here

# Contact form
VITE_MY_CONTACT_EMAIL=your@email.com

# Supabase — get from: Supabase Dashboard > Project > Connect > App Frameworks
# For new projects the key is labeled "Publishable Key" (sb_publishable_xxx)
# For existing projects the anon key still works
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here
